---
import type { GetStaticPaths, Page } from "astro";

import PageHeader from "../../components/PageHeader.astro";
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOG } from "../../config";
import { getPublishedPosts, type Post } from "../../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: BLOG.postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;

const title = page.currentPage > 1 ? `文章 — 第 ${page.currentPage} 页` : "文章";
---

<BaseLayout
  title={title}
  description="小道消息藏机遇，AI 创作更省力。
同创共享好工具，财富自由等着你。"
>
  <div class="wrap">
    <PageHeader
      eyebrow="写作"
      title="文章"
      lede="小道消息藏机遇，AI 创作更省力。
同创共享好工具，财富自由等着你。"
    />

    <div class="post-list">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination page={page} label="文章列表" />
  </div>
</BaseLayout>

<style>
  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }
</style>
