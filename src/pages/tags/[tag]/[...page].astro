---
import type { GetStaticPaths, Page } from "astro";

import PageHeader from "../../../components/PageHeader.astro";
import Pagination from "../../../components/Pagination.astro";
import PostCard from "../../../components/PostCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BLOG } from "../../../config";
import {
  collectTags,
  getPublishedPosts,
  postsByTag,
  type Post,
} from "../../../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();

  return collectTags(posts).flatMap((tag) =>
    paginate(postsByTag(posts, tag.slug), {
      params: { tag: tag.slug },
      pageSize: BLOG.postsPerPage,
      props: { tagName: tag.name },
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  tagName: string;
}

const { page, tagName } = Astro.props;

const suffix = page.currentPage > 1 ? ` — 第 ${page.currentPage} 页` : "";
---

<BaseLayout
  title={`#${tagName}${suffix}`}
  description={`标签「${tagName}」下的文章。`}
>
  <div class="wrap">
    <PageHeader
      eyebrow="标签"
      title={`#${tagName}`}
      lede={`该标签下共 ${page.total} 篇文章。`}
    >
      <p class="tag-page__back label">
        <a href="/tags/">← 全部标签</a>
      </p>
    </PageHeader>

    <div class="post-list">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination page={page} label={`标签「${tagName}」文章`} />
  </div>
</BaseLayout>

<style>
  .tag-page__back {
    margin-top: var(--space-6);
  }

  .tag-page__back a {
    text-decoration: none;
  }

  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }
</style>
