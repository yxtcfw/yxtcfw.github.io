---
import FluidInk from "../components/FluidInk.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOG, INK, SITE } from "../config";
import { getPublishedPosts } from "../utils/posts";

const posts = (await getPublishedPosts()).slice(0, BLOG.postsOnHome);

const cards = [
  {
    title: "小道消息藏机遇",
    desc: "信息差就是利润差，把风声变成先手。",
    href: "/opportunities/",
  },
  {
    title: "智能创作更省力",
    desc: "AI 辅助写作与设计，一个人也能高产。",
    href: "/ai-tools/",
  },
  {
    title: "同创共享好工具",
    desc: "沉淀可复用的工具与流程，开放共享。",
    href: "/tools/",
  },
  {
    title: "财富自由等着你",
    desc: "从副业到一人企业，慢慢把路走宽。",
    href: "/journey/",
  },
];
---

<BaseLayout overlayHeader>
  <FluidInk variant="hero" enabled={INK.hero}>
    <div class="hero">
      

      <div class="hero__cards">
        {
          cards.map((card) => (
            <a class="card" href={card.href}>
              <span class="card__title">{card.title}</span>
              <span class="card__desc">{card.desc}</span>
              <span class="card__more">进入 →</span>
            </a>
          ))
        }
      </div>
    </div>

    {
      SITE.titleMark && (
        <p class="hero__rail tategaki" aria-hidden="true">
          宇轩同创 — 一人企业
        </p>
      )
    }

    {
      INK.hero && (
        <p class="hero__notes" aria-hidden="true">
          <span>墨迹模拟 / WebGL2</span>
          <span class="hero__notes-mid">向下滚动 ↓</span>
          <span>移动指针，搅动墨迹</span>
        </p>
      )
    }
  </FluidInk>

  <section class="section wrap">
    <div class="latest__head">
      <h2 class="eyebrow">最新文章</h2>
      <a class="latest__all label" href="/blog/">全部文章 →</a>
    </div>

    <div class="latest__list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  {
    INK.divider && (
      <FluidInk variant="divider" strength={INK.strength * 0.7}>
        <p class="divider__label label">宇 — 打工人创业实录</p>
      </FluidInk>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-24) var(--gutter);
    text-align: center;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    font-family: var(--font-mono);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
    text-transform: none;
  }

  .hero__lede {
    max-width: 32rem;
    font-size: var(--text-md);
    color: var(--color-fg-muted);
  }

  /* 4 张卡片 */
  .hero__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    width: 100%;
    max-width: 60rem;
    margin-top: var(--space-4);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4);
    border: var(--rule-width) solid var(--color-rule);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    text-align: left;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg));
  }

  .card__title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
  }

  .card__desc {
    flex: 1;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .card__more {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  .card:hover .card__more {
    color: var(--color-accent);
  }

  .hero__rail {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
  }

  .hero__notes {
    display: none;
    position: absolute;
    inset-inline: var(--gutter);
    bottom: var(--space-6);
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  :global(.ink:has([data-ink-active])) .hero__notes {
    display: flex;
  }

  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .latest__all {
    text-decoration: none;
  }

  .latest__all:hover {
    color: var(--color-accent);
  }

  .latest__list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .divider__label {
    margin: auto;
    text-align: center;
  }

  @media (max-width: 55rem) {
    .hero__rail,
    .hero__notes-mid {
      display: none;
    }

    .hero__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    :global(.ink:has([data-ink-active])) .hero__notes {
      display: none;
    }

    .hero__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
